#Область ПрограммныйИнтерфейс 

// Формирует отчет о выполнении клиентских тестов.
// Вызывает общую функцию формирования отчета из модуля яя_клиентСервер
// для текущего модуля клиентского тестирования.
//
// Возвращаемое значение:
//   ТекстовыйДокумент - отчет о выполнении тестов с результатами и временем выполнения.
//
// Пример:
//   отчет = яя_тестыКлиент.ОтчетОТестировании();
//   отчет.Показать();
//
Функция ОтчетОТестировании() Экспорт

	Возврат яя_клиентСервер.ОтчетОТестировании("яя_тестыКлиент");
	
КонецФункции

// Возвращает список доступных клиентских тестов.
// Функция содержит перечень всех доступных тестовых процедур модуля.
// Каждый тест проверяет корректность работы клиентской логики и форм.
//
// Возвращаемое значение:
//   СписокЗначений - список имен тестовых процедур для выполнения.
//
// Пример:
//   список = яя_тестыКлиент.СписокТестов();
//   Для Каждого элемент Из список Цикл
//       Выполнить(элемент.Значение);
//   КонецЦикла;
//
Функция СписокТестов() Экспорт
	
	результат = Новый СписокЗначений;
	
	// Сюда вставлять новые процедуры тестов
	результат.Добавить("Тест_ОткрытиеФормОбъектов()");
	
	Возврат результат;
	
КонецФункции // СписокТестов

#КонецОбласти // Программный интерфейс

#Область Тесты

// Тестирует открытие основных форм объектов конфигурации.
// Проверяет возможность открытия форм справочников и документов без ошибок.
// При неудачном открытии любой формы генерирует исключение с описанием ошибки.
//
// Пример:
//   яя_тестыКлиент.Тест_ОткрытиеФормОбъектов();
//
Процедура Тест_ОткрытиеФормОбъектов() Экспорт
	
	именаФорм = Новый Массив;
	
	// Чтобы обновить имена измененных форм объектов надо попросить у ИИ агента такое:
	//
	// Добавь в яя_тестыКлиент.Тест_ОткрытиеФормОбъектов() все формы объектов, которые изменены.
	// Их можно найти по наличию в модуле форма метода яя_инъекцииКлиентСервер.Форма_ПодменитьОбработчикПриСозданииНаСервере()
	
	// <Сюда вставлять имена проверяемых форм> 
	именаФорм.Добавить("ОбщаяФорма.ЦеныИВалюта");
	именаФорм.Добавить("Документ.АвансовыйОтчет.ФормаОбъекта");
	именаФорм.Добавить("Документ.АктВыполненныхРабот.ФормаОбъекта");
	именаФорм.Добавить("Документ.ЗаказПокупателя.ФормаОбъекта");
	именаФорм.Добавить("Документ.РасходнаяНакладная.Форма.ФормаДокумента");
	именаФорм.Добавить("Документ.РасходнаяНакладная.Форма.ФормаСписка");
	именаФорм.Добавить("Документ.СборкаЗапасов.Форма.ФормаДокумента");
	именаФорм.Добавить("Документ.СборкаЗапасов.Форма.ФормаСписка");
	именаФорм.Добавить("Документ.Событие.Форма.ФормаДокумента");
	именаФорм.Добавить("Документ.Событие.Форма.ФормаЭлектронногоПисьма");
	именаФорм.Добавить("Документ.СчетНаОплату.ФормаОбъекта");
	именаФорм.Добавить("Документ.яя_КоммерческоеПредложение.ФормаОбъекта");
	именаФорм.Добавить("Документ.яя_КоммерческоеПредложение.ФормаСписка");
	именаФорм.Добавить("Обработка.ФормированиеЦенНоменклатуры.Форма.ФормаПомощника");
	именаФорм.Добавить("Обработка.яя_Почта.Форма.Форма");
	именаФорм.Добавить("Обработка.яя_77_ЗагрузкаДокументов.Форма.Форма");
	именаФорм.Добавить("Обработка.яя_77_ЗагрузкаНоменклатуры.Форма.Форма");
	именаФорм.Добавить("Обработка.яя_77_КорректировкаНоменклатуры.Форма.Форма");
	именаФорм.Добавить("Обработка.яя_обмен_ВыгрузкаДокументов.Форма.Форма");
	именаФорм.Добавить("РегистрСведений.СвязиКонтрагентКонтакт.Форма.ИсторияСвязейСКонтактами");
	именаФорм.Добавить("Справочник.ДоговорыКонтрагентов.ФормаОбъекта");
	именаФорм.Добавить("Справочник.Контрагенты.ФормаОбъекта");
	именаФорм.Добавить("Справочник.Контрагенты.ФормаСписка");
	именаФорм.Добавить("Справочник.КонтактныеЛица.ФормаОбъекта");
	именаФорм.Добавить("Справочник.Номенклатура.ФормаОбъекта");
	именаФорм.Добавить("Справочник.Номенклатура.ФормаСписка");
	именаФорм.Добавить("Справочник.Организации.Форма.ФормаЭлемента");
	именаФорм.Добавить("Справочник.Организации.Форма.ФормаСписка");
	именаФорм.Добавить("Справочник.СостоянияЗаказовПокупателей.ФормаОбъекта");
	именаФорм.Добавить("Справочник.ШаблоныСообщений.Форма.СформироватьСообщение");
	// </Сюда вставлять имена проверяемых форм>
	
	ошибки = Новый Массив;
	Для Каждого имя Из именаФорм Цикл
		Попытка
			// BSLLS:GetFormMethod-off
			форма = ПолучитьФорму(имя);
			форма.Открыть();
			Если форма.Открыта() Тогда
				форма.Закрыть();
				
			Иначе 
				ВызватьИсключение "Форма не открылась, возможно ошибка в обработчике `ПриОткрытии`";
				
			КонецЕсли;
			
		Исключение
			обОшибке = ОписаниеОшибки();
			текстОшибки = 
				СтрШаблон(
					"Не открывается форма '%1'
					|по причине: 
					|%2",
					имя, // %1
					обОшибке	); // %2
					
			ошибки.Добавить(текстОшибки);
			
		КонецПопытки;
		
	КонецЦикла;
	имя = Неопределено;

	Если ошибки.Количество() = 0 Тогда
		Возврат;
		
	КонецЕсли;
	
	ВызватьИсключение СтрСоединить(ошибки, Символы.ПС + Символы.ПС);
	
КонецПроцедуры

#КонецОбласти // Тесты