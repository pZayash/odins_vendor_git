// Формирует отчет о выполнении тестов печати.
//
// Возвращаемое значение:
//   ТекстовыйДокумент - отчет о выполнении тестов с результатами и временем выполнения.
//
Функция ОтчетОТестировании() Экспорт

	Возврат яя_клиентСервер.ОтчетОТестировании("яя_тестыПечать");

КонецФункции

// Возвращает список доступных тестов печати.
//
// Возвращаемое значение:
//   СписокЗначений - список имен тестовых процедур для выполнения.
//
Функция СписокТестов() Экспорт

	результат = Новый СписокЗначений;

	результат.Добавить("Тест_ОбработкиПечати_ВерсииВстроенныхНовееВнешних()");
	результат.Добавить("Тест_ОбработкиПечати_ВключеныВПодсистему()");
	результат.Добавить("Тест_ОбработкиПечати_МетодПечатьМодуляМенеджера()");
	результат.Добавить("Тест_ОбработкиПечати_СведенияОВнешнейОбработке()");
	результат.Добавить("Тест_ОбработкиПечати_ФормированиеПечатныхФорм()");
	результат.Добавить("Тест_РольБазовыеПрава_ОбработкиПечати()");

	результат.СортироватьПоЗначению();

	Возврат результат;

КонецФункции // СписокТестов

#КонецОбласти // Программный интерфейс

#Область Тесты

// Тест: версии встроенных обработок печати должны быть строго больше внешних.
// Внешние обработки — временный патч. При равных или больших версиях внешняя
// побеждает встроенную. Если встроенная не новее — патч не перенесён.
//
// +кпср Заяш 260408
Процедура Тест_ОбработкиПечати_ВерсииВстроенныхНовееВнешних() Экспорт

	ошибки = Новый Массив;

	Для Каждого метаОбработки Из Обработки.яя_Печать.МетаданныеОбработокПечати() Цикл

		внешняяИнфо = Обработки.яя_Печать.ЗаменяющаяВнешняяОбработка_Инфо(метаОбработки);
		Если внешняяИнфо = Неопределено Тогда
			Продолжить;

		КонецЕсли;
		
		версияВнешней = внешняяИнфо.Версия;

		версияВстроенной = метаОбработки.Комментарий;
		сравнение = Обработки.яя_Печать.СравнитьВерсииОбработок(версияВстроенной, версияВнешней);

		Если сравнение <= 0 Тогда
			текстОшибки = СтрШаблон(
				"Обработка '%1': встроенная версия '%2' не новее внешней '%3'. Патч не перенесён!",
				метаОбработки.Имя, версияВстроенной, версияВнешней);
			ошибки.Добавить(текстОшибки);

		КонецЕсли;

	КонецЦикла;
	метаОбработки = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ошибки, Символы.ПС);

	КонецЕсли;

КонецПроцедуры

// Тест проверяет, что все обработки печати с префиксом яя_Печать_
// включены в подсистему яя_Печать
//
// +кпср Заяш 260210
Процедура Тест_ОбработкиПечати_ВключеныВПодсистему() Экспорт

	ошибки = Новый Массив;

	подсистемаПечать = Метаданные.Подсистемы.яя_.Подсистемы.яя_Печать;
	составПодсистемы = подсистемаПечать.Состав;

	метаданныеОбработокПечати = Обработки.яя_Печать.МетаданныеОбработокПечати();

	Для Каждого метаОбработки Из метаданныеОбработокПечати Цикл
		Если Не составПодсистемы.Содержит(метаОбработки) Тогда
			текстОшибки = СтрШаблон(	"Обработка '%1' не включена в подсистему '%2'",
										метаОбработки.Имя, яя_лит.яя_Печать_()			);
			ошибки.Добавить(текстОшибки);

		КонецЕсли;

	КонецЦикла;
	метаОбработки = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		полныйТекстОшибки = СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение полныйТекстОшибки;

	КонецЕсли;

КонецПроцедуры

// Тест проверяет наличие экспортной процедуры Печать() в модуле менеджера обработки
// у всех обработок печати с префиксом яя_Печать_
// Эта процедура необходима для возможности вызова метода ОбработкаОбъект.Печать(), когда обработка печати
// включена в конфигурацию.
// См. УправлениеПечатю.СформироватьПечатныеФормы
// вшеншние обработки используют ОбработкаОбъект.Печать(), а встроенные Обработки.ИмяОбработки.Печать(), т.е.
// модуль менеджера. Тест проверяет что в обработку добавлен метод-переадресатор из менеджера в модуль обработки
//
// +кпср Заяш 260119
Процедура Тест_ОбработкиПечати_МетодПечатьМодуляМенеджера() Экспорт

	ошибки = Новый Массив;

	Для Каждого метаОбработки Из Обработки.яя_Печать.МетаданныеОбработокПечати() Цикл

		Попытка
			менеджерОбработки = общ.Менеджер_ПоОбъекту(метаОбработки);
			Если общ.МетодРеализован(менеджерОбработки, "Печать") Тогда
				Продолжить;

			КонецЕсли;

			текстОшибки = СтрШаблон("Обработка '%1': менеджер не содержит процедуру 'Печать()'",
					метаОбработки.Имя		);
			ошибки.Добавить(текстОшибки);

		Исключение
			описаниеОшибки = ОписаниеОшибки();
			текстОшибки = СтрШаблон(
				"Обработка '%1': %2",
				метаОбработки.Имя, // %1
				описаниеОшибки		); // %2
			ошибки.Добавить(текстОшибки);

		КонецПопытки;

	КонецЦикла;
	метаОбработки = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		полныйТекстОшибки = СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение полныйТекстОшибки;

	КонецЕсли;

КонецПроцедуры

// Тест проверяет наличие экспортной функции СведенияОВнешнейОбработке()
// у всех обработок печати с префиксом яя_Печать_
// Эта функция необходима для автоматического подключения команд печати.
//
// +кпср Заяш 260119
Процедура Тест_ОбработкиПечати_СведенияОВнешнейОбработке() Экспорт

	ошибки = Новый Массив;

	Для Каждого метаОбработки Из Обработки.яя_Печать.МетаданныеОбработокПечати() Цикл

		Попытка
			объектОбработки = Обработки[метаОбработки.Имя].Создать();
			сведения = объектОбработки.СведенияОВнешнейОбработке();

			Если Не сведения.Свойство("Назначение") Или сведения.Назначение.Количество() = 0 Тогда
				ВызватьИсключение "СведенияОВнешнейОбработке не содержит свойство 'Назначение'";

			КонецЕсли;

			Если Не сведения.Свойство("Команды") Или сведения.Команды.Количество() = 0 Тогда
				ВызватьИсключение "СведенияОВнешнейОбработке не содержит свойство 'Команды'";

			КонецЕсли;

		Исключение
			описаниеОшибки = ОписаниеОшибки();
			текстОшибки = СтрШаблон(
				"Обработка '%1': %2",
				метаОбработки.Имя, // %1
				описаниеОшибки		); // %2
			ошибки.Добавить(текстОшибки);

		КонецПопытки;

	КонецЦикла;
	метаОбработки = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		полныйТекстОшибки = СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение полныйТекстОшибки;

	КонецЕсли;

КонецПроцедуры

// Тест проверяет, что метод Печать() каждой команды каждой обработки яя_Печать_*
// формирует табличный документ без ошибок.
// Для каждой команды вызывается Печать() с пустой ссылкой объекта соответствующего типа.
//
// +кпср Заяш 260303
Процедура Тест_ОбработкиПечати_ФормированиеПечатныхФорм() Экспорт

	ошибки = Новый Массив;

	// Шаблон текста запроса
	// Пустая ссылка, основная проверка формирования печатной формы. Форма должна формироваться по пустой ссылке
	// Добавить три ссылки последних проведенных документов для контроля
	// @TODO Когда будут печатные формы справочников это место надо переработать
	шаблонТекстаЗапроса =
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка) КАК Ссылка,
		|	НЕОПРЕДЕЛЕНО КАК Дата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 3
		|	Т.Ссылка,
		|	Т.Дата
		|ИЗ
		|	Документ.ЗаказПокупателя КАК Т
		|ГДЕ
		|	Т.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";

	Для Каждого метаОбработки Из Обработки.яя_Печать.МетаданныеОбработокПечати() Цикл

		Попытка
			объектОбработки = Обработки[метаОбработки.Имя].Создать();
			сведения = объектОбработки.СведенияОВнешнейОбработке();
			назначенияОбработки = сведения.Назначение;

		Исключение
			обОшибке = ОписаниеОшибки();
			текстОшибки = СтрШаблон("Обработка '%1': %2", метаОбработки.Имя, обОшибке);
			ошибки.Добавить(текстОшибки);
			Продолжить;

		КонецПопытки;

		Для Каждого имяОбъекта Из назначенияОбработки Цикл
			запрос = Новый Запрос;
			запрос.Текст = СтрЗаменить(шаблонТекстаЗапроса, "Документ.ЗаказПокупателя", имяОбъекта);
			ссылкиКПроверке = запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
			Для Каждого команда Из сведения.Команды Цикл
				Для Каждого ссылкаОбъекта Из ссылкиКПроверке Цикл

					Попытка
						коллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(команда.Идентификатор);
						объектыПечати = Новый СписокЗначений;
						параметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();

						ссылкаВМассиве = общ.Массив_ПоЗначению(ссылкаОбъекта);
						Обработки[метаОбработки.Имя].Печать(ссылкаВМассиве, Неопределено,
														коллекцияПечатныхФорм, объектыПечати, параметрыВывода);

						Если коллекцияПечатныхФорм.Количество() = 0 Или коллекцияПечатныхФорм[0].ТабличныйДокумент = Неопределено Тогда
							ВызватьИсключение "ТабличныйДокумент не сформирован";

						КонецЕсли;

					Исключение
						навСсылка = общ.НавигационнаяСсылка(ссылкаОбъекта);
						текстОшибки = СтрШаблон(	"Обработка '%1', команда '%2': ошибка Печать(): %3
													|	%4",
													метаОбработки.Имя, // %1
													команда.Идентификатор, // %2
													ОписаниеОшибки(), // %3
													навСсылка		);

						ошибки.Добавить(текстОшибки);
						яя_.ВЖурналОшибка("Тест_ОбработкиПечати_ФормированиеПечатныхФорм", ИнформацияОбОшибке(), "яя_тестыПечать");

						// Если ошибка была при печати по пустой ссылке, то дальшнейшие проверки по заполненным не нужны
						Если ссылкаОбъекта.Пустая() Тогда
							Прервать;

						КонецЕсли;

					КонецПопытки;

				КонецЦикла;
				ссылкаОбъекта = Неопределено;

			КонецЦикла;
			команда = Неопределено;

		КонецЦикла;
		имяОбъекта = Неопределено;

	КонецЦикла;
	метаОбработки = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ошибки, Символы.ПС);

	КонецЕсли;

КонецПроцедуры

// Тест проверяет наличие прав "Использование" и "Просмотр" у роли яя_БазовыеПрава
// на все обработки печати с префиксом яя_Печать_
//
// +кпср Заяш 260210
Процедура Тест_РольБазовыеПрава_ОбработкиПечати() Экспорт

	рольБазовыеПрава = Метаданные.Роли.яя_БазовыеПрава;
	ошибки = Новый Массив;

	проверяемыеПрава = "Использование, Просмотр";
	проверяемыеПрава = общ.Строка_РазделитьСокрЛП(проверяемыеПрава);

	Для Каждого метаОбработки Из Обработки.яя_Печать.МетаданныеОбработокПечати() Цикл
		Для Каждого право Из проверяемыеПрава Цикл
			Если ПравоДоступа(право, метаОбработки, рольБазовыеПрава) Тогда
				Продолжить;

			КонецЕсли;

			текстОшибки = СтрШаблон("У роли '%1' отсутствует право '%2' для обработки '%3'",
									рольБазовыеПрава.Имя, // %1
									право, // %2
									метаОбработки.ПолноеИмя() 		);
			ошибки.Добавить(текстОшибки);

		КонецЦикла;
		право = Неопределено;

	КонецЦикла;
	метаОбработки = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		полныйТекстОшибки = СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение полныйТекстОшибки;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти // Тесты
