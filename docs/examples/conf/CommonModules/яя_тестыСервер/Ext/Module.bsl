// Тест проверяет наличие прав "Использование" и "Просмотр" у роли на обработки
//
// +кпср Заяш 260218 12:53 
Процедура Тест_ПравоНаОбработки(пРоль, пМетаданныеОбработок)

	ошибки = Новый Массив;

	проверяемыеПрава = "Использование, Просмотр";
	проверяемыеПрава = общ.Строка_РазделитьСокрЛП(проверяемыеПрава);

	Для Каждого метаОбработки Из пМетаданныеОбработок Цикл
		Для Каждого право Из проверяемыеПрава Цикл
			Если ПравоДоступа(право, метаОбработки, пРоль) Тогда
				Продолжить;

			КонецЕсли;

			текстОшибки = СтрШаблон("У роли '%1' отсутствует право '%2' для обработки '%3'",
									пРоль.Имя, // %1
									право, // %2
									метаОбработки.ПолноеИмя() 		);
			ошибки.Добавить(текстОшибки);

		КонецЦикла;
		право = Неопределено;

	КонецЦикла;
	метаОбработки = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		полныйТекстОшибки = СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение полныйТекстОшибки;

	КонецЕсли;

КонецПроцедуры

