#Область ПрограммныйИнтерфейс

// Формирует отчет о выполнении серверных тестов.
// Вызывает общую функцию формирования отчета из модуля яя_клиентСервер
// для текущего модуля серверного тестирования.
//
// Возвращаемое значение:
//   ТекстовыйДокумент - отчет о выполнении тестов с результатами и временем выполнения.
//
// Пример:
//   отчет = яя_тестыСервер.ОтчетОТестировании();
//   отчет.Показать();
//
Функция ОтчетОТестировании() Экспорт

	Возврат яя_клиентСервер.ОтчетОТестировании("яя_тестыСервер");
	
КонецФункции

// Записывает ошибку теста в журнал регистрации.
// Делегирует вызов в общий модуль яя_ для записи ошибки с указанными параметрами.
//
// Параметры:
//   имяТеста - Строка - имя тестового метода, в котором произошла ошибка.
//   текстОшибки - Строка - текст описания ошибки.
//   имяДанныхЖурнала - Строка - имя данных для группировки записей в журнале.
//
// Пример:
//   яя_тестыСервер.ВЖурналОшибка("Тест_ПроверкаПрав", "Отсутствует право Чтение", "яя_тестыСервер");
//
Процедура ВЖурналОшибка(имяТеста, текстОшибки, имяДанныхЖурнала) Экспорт
	
	яя_.ВЖурналОшибка(имяТеста, текстОшибки, имяДанныхЖурнала);
	
КонецПроцедуры

// Возвращает список доступных серверных тестов.
// Функция содержит перечень всех доступных тестовых процедур модуля.
// Каждый тест проверяет корректность метаданных, прав доступа и обработок печати.
//
// Возвращаемое значение:
//   СписокЗначений - список имен тестовых процедур для выполнения.
//
// Пример:
//   список = яя_тестыСервер.СписокТестов();
//   Для Каждого элемент Из список Цикл
//       Выполнить(элемент.Значение);
//   КонецЦикла;
//
Функция СписокТестов() Экспорт
	
	результат = Новый СписокЗначений;
	
	// Этот тест должен быть первым, он найдет все битые модули объектов
	результат.Добавить("Тест_ЗаписьПустыхОбъектов_СправочникиИДокументы()");
	
	// Сюда вставлять новые процедуры тестов
	результат.Добавить("Тест_ОбработкиМоделиДаных_ВключеныВПодсистему()");
	результат.Добавить("Тест_ОбщиеМодули_ПроверитьФлагКлиентОбычноеПриложение()");
	результат.Добавить("Тест_ПодпискиНаСобытия_МетодыРеализованы()");
	результат.Добавить("Тест_РольБазовыеПрава_ОбработкиМоделиДанных()");
	результат.Добавить("Тест_РольБазовыеПрава_ПрисоединенныеФайлы()");
	результат.Добавить("Тест_ПользовательИБ_ДатьСтандартныеРоли_Идемпотентность()");
	результат.Добавить("Тест_Пользователь_ДатьБазовыеПрава_Идемпотентность()");
	результат.Добавить("Тест_Роли_ИнтерактивноеУдаление()");
	результат.Добавить("Тест_Роли_ПоставляемыеИнтерфейсныеПодсистемы()");
	
	// Эти тесты включить после обновления
	Если Метаданные.Версия >= "3.0.13.238" Тогда
		результат.Добавить("Тест_Реквизиты_ИндексируемыйТекст()");
		
	КонецЕсли;

	результат.СортироватьПоЗначению();

	Возврат результат;

КонецФункции // СписокТестов

#КонецОбласти // Программный интерфейс

#Область Тесты

Процедура Тест_ОбработкиМоделиДаных_ВключеныВПодсистему() Экспорт
	
	подсистема = Метаданные.Подсистемы.яя_.Подсистемы.яя_моделиДанных;
	метаданныеОбработок = ОбработкиМоделиДанных();
	Тест_ОбъектыМетаданных_ВключеныВПодсистему(подсистема, метаданныеОбработок);
	
КонецПроцедуры

// Тест проверяет флаг `КлиентОбычноеПриложение` общих модулей,
// чтобы корректно работала подсистема ИР в режиме толстого клиента
Процедура Тест_ОбщиеМодули_ПроверитьФлагКлиентОбычноеПриложение() Экспорт
	
	ошибки = Новый Массив;

	Для Каждого общийМодуль Из Метаданные.ОбщиеМодули Цикл
		Если общийМодуль.КлиентУправляемоеПриложение И общийМодуль.Сервер И Не общийМодуль.КлиентОбычноеПриложение Тогда
			ошибки.Добавить("" + общийМодуль.ПолноеИмя() + " не установлен флаг КлиентОбычноеПриложение");
			
		КонецЕсли;
		
	КонецЦикла;
	общийМодуль = Неопределено;

	Если ошибки.Количество() Тогда
		текстОшибок = СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение текстОшибок;
		
	КонецЕсли;
	
КонецПроцедуры

// Тест проверяет наличие экспортных методов в модулях объектов,
// которые должны реализовывать дополнения для механизма подписок на события.
// Механизм активируется через яя_.ПодпискиНаСобытия_УстановитьИспользование().
//
// +кпср Заяш 260223
Процедура Тест_ПодпискиНаСобытия_МетодыРеализованы() Экспорт

	ошибки = Новый Массив;

	проверяемыеКорневыеТипыМетаданных = Новый Массив;
	проверяемыеКорневыеТипыМетаданных.Добавить(Метаданные.Документы);
	проверяемыеКорневыеТипыМетаданных.Добавить(Метаданные.Справочники);

	Для Каждого корневойТип Из проверяемыеКорневыеТипыМетаданных Цикл
		Для Каждого метаОбъект Из корневойТип Цикл

			// Создаем новый объект для инициализации подписок
			объект = Неопределено;
			Если корневойТип = Метаданные.Документы Тогда
				объект = Документы[метаОбъект.Имя].СоздатьДокумент();
				
			ИначеЕсли корневойТип = Метаданные.Справочники Тогда
				объект = Справочники[метаОбъект.Имя].СоздатьЭлемент();
				
			Иначе
				л_Ошибка = СтрШаблон("Корневой тип %1 не поддерживается", корневойТип);
				ВызватьИсключение корневойТип;
				
			КонецЕсли;

			// Проверяем каждую подписку
			подпискиОбъекта = яя_.ПодпискиНаСобытия_КоллекцияИспользуемых(объект.ДополнительныеСвойства);
			Для Каждого подписка Из подпискиОбъекта Цикл
				перечислениеСсылка = подписка.Ключ;
				Если Не общ.ЭтоЗаполненнаяСсылка(перечислениеСсылка, Тип("ПеречислениеСсылка.яя_Подписки")) Тогда
					Продолжить;
					
				КонецЕсли;
				
				// Имя метода совпадает с именем значения перечисления
				имяМетода = яя_общ.Перечисление_Имя(перечислениеСсылка);

				// Проверяем наличие экспортного метода
				Если общ.МетодРеализован(объект, имяМетода) Тогда
					Продолжить;
					
				КонецЕсли;
				
				текстОшибки = СтрШаблон("Объект '%1': отсутствует экспортный метод '%2' для подписки '%3'",
						метаОбъект.ПолноеИмя(),
						имяМетода,
						подписка.Ключ);
				ошибки.Добавить(текстОшибки);

			КонецЦикла;
			подписка = Неопределено;
			
		КонецЦикла;
		метаОбъект = Неопределено;
		
	КонецЦикла;
	корневойТип = Неопределено;

	// Результат
	Если ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ошибки, Символы.ПС);
		
	КонецЕсли;

КонецПроцедуры

// Тест проверяет наличие прав "Использование" и "Просмотр" у роли яя_БазовыеПрава
// на все обработки-модели с префиксом яя_модель_
//
// +кпср Заяш 260218 12:53 
Процедура Тест_РольБазовыеПрава_ОбработкиМоделиДанных() Экспорт
	
	рольБазовыеПрава = Метаданные.Роли.яя_БазовыеПрава;
	метаданныеОбработок = Новый Массив;
	Для Каждого мета Из Метаданные.Обработки Цикл
		Если Не СтрНачинаетсяС(мета.Имя, яя_лит.яя_модель_()) Тогда
			Продолжить;
			
		КонецЕсли;
		
		метаданныеОбработок.Добавить(мета);
		
	КонецЦикла;
	мета = Неопределено;

	Тест_ПравоНаОбработки(рольБазовыеПрава, метаданныеОбработок);

КонецПроцедуры

// Тест проверяет наличие прав у роли яя_БазовыеПрава на справочники присоединенных файлов,
// типы которых перечислены в методе яя_конст.ИсточникиПрисоедиенныхФайловАвтоматическиДобавляемыеВИходящиеПисьма.
// Проверяемые права: Изменение, ИнтерактивноеУдалениеПомеченных.
//
// +кпср Заяш 260112 
Процедура Тест_РольБазовыеПрава_ПрисоединенныеФайлы() Экспорт
	
	рольБазовыеПрава = Метаданные.Роли.яя_БазовыеПрава;
	типыИсточников = яя_конст.ИсточникиПрисоедиенныхФайловАвтоматическиДобавляемыеВИходящиеПисьма();
	
	ошибки = Новый Массив; 
	
	проверяемыеПрава = "Добавление, Изменение, ИнтерактивнаяПометкаУдаления";
	проверяемыеПрава = общ.Строка_РазделитьСокрЛП(проверяемыеПрава);
	
	Для Каждого типИсточника Из типыИсточников Цикл
		
		// Получить метаданные справочника по типу ссылки
		метаСправочника = Метаданные.НайтиПоТипу(типИсточника);
		
		Если метаСправочника = Неопределено Тогда
			ошибки.Добавить(СтрШаблон("Не найден объект метаданных для типа %1", типИсточника));
			Продолжить;
			
		КонецЕсли; 
		
		Для Каждого право Из проверяемыеПрава Цикл
			Если ПравоДоступа(право, метаСправочника, рольБазовыеПрава) Тогда
				Продолжить;
				
			КонецЕсли;
			
			текстОшибки = СтрШаблон("У роли '%1' отсутствует право '%2' для справочника '%3'",
											рольБазовыеПрава.Имя, // %1
											право, // %2
											метаСправочника.ПолноеИмя() 		);
			ошибки.Добавить(текстОшибки);
			
		КонецЦикла;
		право = Неопределено;
		
	КонецЦикла;
	типИсточника = Неопределено;
	
	Если ошибки.Количество() > 0 Тогда
		полныйТекстОшибки = СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение полныйТекстОшибки;

	КонецЕсли;

КонецПроцедуры

// Тест проверяет идемпотентность [яя_.ПользовательИБ_ДатьСтандартныеРоли]:
// после первого вызова нужные роли присутствуют, после второго —
// состав ролей не меняется (сравнение по массиву имён ролей).
//
// +кпср Заяш 2026-04-10
Процедура Тест_ПользовательИБ_ДатьСтандартныеРоли_Идемпотентность() Экспорт

	пользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	идентификаторИБ = пользовательИБ.УникальныйИдентификатор;

	// Первый вызов: при необходимости добавит недостающие роли
	яя_.ПользовательИБ_ДатьСтандартныеРоли(пользовательИБ);

	именаРолейПослеПервого = ИменаРолейПользователяИБ(идентификаторИБ);

	// После первого вызова обе целевые роли должны присутствовать
	ошибки = Новый Массив;
	Если именаРолейПослеПервого.Получить("яя_БазовыеПрава") = Неопределено Тогда
		ошибки.Добавить("После первого вызова отсутствует роль яя_БазовыеПрава");

	КонецЕсли;
	Если именаРолейПослеПервого.Получить("яя_ИспользованиеЭлектроннойПочты") = Неопределено Тогда
		ошибки.Добавить("После первого вызова отсутствует роль яя_ИспользованиеЭлектроннойПочты");

	КонецЕсли;

	// Второй вызов: должен быть no-op
	яя_.ПользовательИБ_ДатьСтандартныеРоли(пользовательИБ);

	именаРолейПослеВторого = ИменаРолейПользователяИБ(идентификаторИБ);

	Если именаРолейПослеПервого.Количество() <> именаРолейПослеВторого.Количество() Тогда
		ошибки.Добавить(СтрШаблон(
			"Количество ролей изменилось после второго вызова: было %1, стало %2",
			именаРолейПослеПервого.Количество(),
			именаРолейПослеВторого.Количество()));

	КонецЕсли;

	Для Каждого элемент Из именаРолейПослеПервого Цикл
		Если именаРолейПослеВторого.Получить(элемент.Ключ) = Неопределено Тогда
			ошибки.Добавить(СтрШаблон("После второго вызова пропала роль '%1'", элемент.Ключ));

		КонецЕсли;

	КонецЦикла;
	элемент = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ошибки, Символы.ПС);

	КонецЕсли;

КонецПроцедуры

// Тест проверяет идемпотентность [яя_.Пользователь_ДатьБазовыеПрава]:
// двойной вызов оставляет пользователя в табличной части Пользователи
// группы доступа `ГруппаДоступа_БазовыеПрава` ровно один раз.
//
// +кпср Заяш 2026-04-10
Процедура Тест_Пользователь_ДатьБазовыеПрава_Идемпотентность() Экспорт

	текущийПользователь = Пользователи.ТекущийПользователь();
	группаДоступа = яя_конст.ГруппаДоступа_БазовыеПрава();

	Если Не общ.ЭтоЗаполненнаяСсылка(группаДоступа) Тогда
		ВызватьИсключение "яя_конст.ГруппаДоступа_БазовыеПрава() не заполнена — тест неприменим";

	КонецЕсли;

	// Первый и второй вызов
	яя_.Пользователь_ДатьБазовыеПрава(текущийПользователь);
	яя_.Пользователь_ДатьБазовыеПрава(текущийПользователь);

	запрос = Новый Запрос;
	запрос.УстановитьПараметр("Пользователь", текущийПользователь);
	запрос.УстановитьПараметр("ГруппаДоступа", группаДоступа);
	запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК П
	|ГДЕ
	|	П.Ссылка = &ГруппаДоступа
	|	И П.Пользователь = &Пользователь";

	выборка = запрос.Выполнить().Выбрать();
	выборка.Следующий();
	количество = выборка.Количество;

	Если количество <> 1 Тогда
		ВызватьИсключение СтрШаблон(
			"После двойного вызова Пользователь_ДатьБазовыеПрава пользователь '%1' присутствует в группе доступа '%2' %3 раз (ожидается 1)",
			текущийПользователь,
			группаДоступа,
			количество);

	КонецЕсли;

КонецПроцедуры

// Возвращает соответствие имён ролей пользователя ИБ по его идентификатору.
// Используется для сравнения составов ролей в тестах идемпотентности.
Функция ИменаРолейПользователяИБ(идентификаторИБ)

	результат = Новый Соответствие;
	свойстваИБ = Пользователи.СвойстваПользователяИБ(идентификаторИБ);
	Если свойстваИБ = Неопределено Тогда
		Возврат результат;

	КонецЕсли;

	// БСП Пользователи.СвойстваПользователяИБ возвращает Роли как массив строк (имён)
	Для Каждого имяРоли Из свойстваИБ.Роли Цикл
		результат.Вставить(имяРоли, Истина);

	КонецЦикла;

	Возврат результат;

КонецФункции

// Тест проверяет отсутствие права "ИнтерактивноеУдаление" у всех ролей
// для справочников, документов и планов видов характеристик.
//
// +кпср Заяш 260209
Процедура Тест_Роли_ИнтерактивноеУдаление() Экспорт
	
	ошибки = Новый Массив;
	
	коллекцииМетаданных = Новый Структура;
	коллекцииМетаданных.Вставить("Справочники", Метаданные.Справочники);
	коллекцииМетаданных.Вставить("Документы", Метаданные.Документы);
	коллекцииМетаданных.Вставить("ПланыВидовХарактеристик", Метаданные.ПланыВидовХарактеристик);
	
	Для Каждого роль Из Метаданные.Роли Цикл
		Для Каждого кв Из коллекцииМетаданных Цикл
			коллекция = кв.Значение;
			
			Для Каждого объектМетаданных Из коллекция Цикл
				Если ПравоДоступа("ИнтерактивноеУдаление", объектМетаданных, роль) Тогда
					
					// Исключение: роль ирРазработчик может удалять объекты подсистемы ИР
					Если роль = Метаданные.Роли.ирРазработчик И СтрНайти(объектМетаданных.Имя, "ир") = 1 Тогда
						Продолжить;
						
					КонецЕсли;
					
					текстОшибки = СтрШаблон("Роль '%1' имеет право 'ИнтерактивноеУдаление' для объекта '%2'",
						роль.Имя,
						объектМетаданных.ПолноеИмя());
						
					ошибки.Добавить(текстОшибки);
					
				КонецЕсли;
				
			КонецЦикла;
			объектМетаданных = Неопределено;
			
		КонецЦикла;
		кв = Неопределено;
		
	КонецЦикла;
	роль = Неопределено;
	
	Если ошибки.Количество() > 0 Тогда
		текстОшибки = Символы.ПС + СтрСоединить(ошибки, Символы.ПС);
		ВызватьИсключение текстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

// Тест проверяет, что доступ к поставляемым подсистемам, отображаемым в интерфейсе
// имеют только роли, которые включены в эти подсистемы.
// Проверяется, что ни одна лишняя роль не имеет права доступа к этим подсистемам.
//
// +кпср Заяш 260211
Процедура Тест_Роли_ПоставляемыеИнтерфейсныеПодсистемы() Экспорт
	
	ошибки = Новый Массив;
	
	подсистемы = Новый Массив;
	подсистемы.Добавить(Метаданные.Подсистемы.ИнструментыРазработчикаTormozit);
	подсистемы.Добавить(Метаданные.Подсистемы.обм_Интерфейсная);
	подсистемы.Добавить(Метаданные.Подсистемы.яя_тесты);
	
	Для Каждого роль Из Метаданные.Роли Цикл
		Для Каждого подсистема Из подсистемы Цикл
			Если подсистема.Состав.Содержит(роль) Тогда
				Продолжить;
				
			КонецЕсли;
			
			Если ПравоДоступа("Просмотр", подсистема, роль) Тогда
				текстОшибки = СтрШаблон("Роль '%1' имеет право просмотра к подсистемы '%2'", роль.Имя, подсистема.Имя);
				ошибки.Добавить(текстОшибки);
				
			КонецЕсли;
			
		КонецЦикла;
		подсистема = Неопределено;
		
	КонецЦикла;
	роль = Неопределено;
	
	// Результат
	Если ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ошибки, Символы.ПС);
		
	КонецЕсли;
	
КонецПроцедуры

// Тест проверяет, что у реквизитов документов и справочников,
// имеющих тип ОпределяемыйТип.яя_индексируемыйТекст,
// установлен флаг "Индексировать"
//
// +кпср Заяш 260223
Процедура Тест_Реквизиты_ИндексируемыйТекст() Экспорт

	ошибки = Новый Массив;
	
	// Строка 625 символов. Довольно уникально, не должно быть ложных срабатываний
	описаниеТипаИндексируемогоТекста = Метаданные.ОпределяемыеТипы.яя_ИндексируемыйТекст.Тип;

	проверяемыеКорневыеТипыМетаданных = Новый Массив;
	проверяемыеКорневыеТипыМетаданных.Добавить(Метаданные.Справочники);
	проверяемыеКорневыеТипыМетаданных.Добавить(Метаданные.Документы);

	Для Каждого корневойТип Из проверяемыеКорневыеТипыМетаданных Цикл
		Для Каждого мета Из корневойТип Цикл
			Для Каждого реквизит Из мета.Реквизиты Цикл
				
				// Проверяем, содержит ли тип реквизита определяемый тип яя_индексируемыйТекст
				этоРеквизитНужногоТипа = реквизит.Тип = описаниеТипаИндексируемогоТекста;
				Если Не этоРеквизитНужногоТипа Тогда
					Продолжить;
					
				КонецЕсли;

				// Если реквизит содержит определяемый тип, проверяем флаг Индексировать
				индексируется = реквизит.Индексирование <> Метаданные.СвойстваОбъектов.Индексирование.НеИндексировать;
				Если индексируется Тогда
					Продолжить;
					
				КонецЕсли;
				
				текстОшибки = СтрШаблон("У реквизита `%2.%1` не установлено свойство `Индексирование`",
										реквизит.Имя,
										мета.ПолноеИмя());
				ошибки.Добавить(текстОшибки);

			КонецЦикла;
			реквизит = Неопределено;

		КонецЦикла;
		мета = Неопределено;
		
	КонецЦикла;
	корневойТип = Неопределено;

	// Результат
	Если ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ошибки, Символы.ПС);
		
	КонецЕсли;

КонецПроцедуры

// Тест проверяет, что для всех справочников и документов конфигурации
// можно создать и записать пустой объект без ошибок.
// Запись выполняется в транзакции, которая всегда отменяется.
//
// +кпср Заяш 260402
Процедура Тест_ЗаписьПустыхОбъектов_СправочникиИДокументы() Экспорт
	
	// Движок тестов открывает транзакцию, чтобы тесты ничего не поменяли в базе
	// Мы эту транзакцию отменим, потому что этот тест сам делает транзакции на запись каждого объекта
	// А транзакция движка маскирует ошибку по "В этой транзакции уже происходили ошибки"
	Пока ТранзакцияАктивна() Цикл
		ОтменитьТранзакцию();
		
	КонецЦикла;
	
	ошибки = Новый Массив;

	// Справочники
	Для Каждого метаСправочник Из Метаданные.Справочники Цикл
		НачатьТранзакцию();
		Попытка
			объект = Справочники[метаСправочник.Имя].СоздатьЭлемент();
			объект.ОбменДанными.Загрузка = Истина;
			объект.Записать();
			ОтменитьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ошибки.Добавить(СтрШаблон("Справочник.%1: %2",
				метаСправочник.Имя, ОписаниеОшибки()));

		КонецПопытки;

	КонецЦикла;
	метаСправочник = Неопределено;

	// Документы
	Для Каждого метаДокумент Из Метаданные.Документы Цикл
		НачатьТранзакцию();
		Попытка
			объект = Документы[метаДокумент.Имя].СоздатьДокумент();
			объект.Дата = ТекущаяДатаСеанса();
			объект.ОбменДанными.Загрузка = Истина;
			объект.Записать();
			ОтменитьТранзакцию();

		Исключение
			ОтменитьТранзакцию();
			ошибки.Добавить(СтрШаблон("Документ.%1: %2",
				метаДокумент.Имя, ОписаниеОшибки()));

		КонецПопытки;

	КонецЦикла;
	метаДокумент = Неопределено;

	Если ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ошибки, Символы.ПС);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти // Тесты

#Область ШаблоныТестов

// Тест проверяет, что обработки включены в подсистему
//
// +кпср Заяш 260218 13:04 
