flowchart TD
    A["Начало: есть доработанная конфигурация 1С"] --> B["Подготовить правила доработок<br/>- не трогать объекты поставщика<br/>- изменения форм вносить кодом<br/>- свои объекты держать отдельно"]

    B --> C["Получить базовую конфигурацию поставщика"]
    C --> D["Выгрузить ее в файлы через конфигуратор"]
    D --> E["Создать git-репозиторий<br/>и зафиксировать базовую поставку"]

    E --> F["Создать ветку поставщика"]
    F --> G["Получить новую конфигурацию поставщика"]
    G --> H["Выгрузить новую поставку в файлы"]
    H --> I["Закоммитить новую поставку<br/>в ветке поставщика"]

    E --> J["Переключиться в основную ветку"]
    J --> K["Выгрузить доработанную конфигурацию<br/>в файловое представление"]
    K --> L["Закоммитить доработанную конфигурацию"]

    I --> M["Выполнить git merge<br/>ветки поставщика в основную ветку"]
    L --> M

    M --> N{"Есть конфликты?"}
    N -- "Нет" --> O["Получить объединенный результат"]
    N -- "Да" --> P["Разобрать автоматические merge-результаты"]
    P --> Q["Отфильтровать артефакты<br/>XML, справки, бинарные хвосты"]
    Q --> R["Открыть спорные места<br/>во внешнем merge-инструменте"]
    R --> S["Разрешить реальные конфликты вручную<br/>по 3 сторонам:<br/>база / доработка / новая поставка"]
    S --> O

    O --> T["Подготовить итоговую файловую конфигурацию"]
    T --> U["Сначала штатно залить конфигурацию поставщика<br/>в конфигуратор"]
    U --> V["Затем загрузить подготовленную<br/>конфигурацию из файлов"]

    V --> W{"Загрузка прошла без ошибок?"}
    W -- "Нет" --> X["Открыть проблемные файлы<br/>и исправить merge-ошибки"]
    X --> V
    W -- "Да" --> Y["Запустить синтаксический контроль"]

    Y --> Z{"Есть ошибки?"}
    Z -- "Да" --> AA["Исправить проблемные места<br/>и повторить проверку"]
    AA --> Y
    Z -- "Нет" --> AB["Запустить полную проверку<br/>и дымовые/поведенческие тесты"]

    AB --> AC{"Тесты успешны?"}
    AC -- "Нет" --> AD["Разобрать дефекты обновления<br/>и скорректировать объединение"]
    AD --> T
    AC -- "Да" --> AE["Обновление завершено"]

    AF["Опционально: автоматизировать подготовку релизов<br/>и репозитория через специальные инструменты"] -.-> G
    AF -.-> T

    AG["Постоянная работа в git дает бонусы:<br/>история релизов, авторство, сравнение с поставщиком,<br/>возможность прерывать обновление"] -.-> AE
